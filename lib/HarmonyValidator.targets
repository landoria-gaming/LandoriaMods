<Project>
  <PropertyGroup>
    <HarmonyValidatorExe Condition="'$(HarmonyValidatorExe)' == ''">$(MSBuildThisFileDirectory)HarmonyValidator.exe</HarmonyValidatorExe>
  </PropertyGroup>
  <Target Name="ValidateHarmonyTargets"
          AfterTargets="CoreCompile"
          BeforeTargets="CopyFilesToOutputDirectory;MergeLandoriaSharedLib"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(HarmonyValidatorExe)')"
           Text="HarmonyValidator executable not found: $(HarmonyValidatorExe). Build HarmonyValidator.csproj in Release first." />
    <PropertyGroup>
      <_HvAssembly>@(IntermediateAssembly->'%(FullPath)')</_HvAssembly>
      <_HvRefs>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)</_HvRefs>
      <_HvRefs>$(_HvRefs)harmony-references.txt</_HvRefs>
    </PropertyGroup>
    <WriteLinesToFile File="$(_HvRefs)"
                      Lines="@(ReferencePath->'%(FullPath)')"
                      Overwrite="true" />
    <Exec Command="&quot;$(HarmonyValidatorExe)&quot; &quot;$(_HvAssembly)&quot; &quot;$(_HvRefs)&quot;" />
  </Target>
</Project>
